.venv/
__pycache__/
*.pyc
*.log
*.csv
# ...except the numbers a paper figure draws. The convention in
# .claude/skills/exp-plot requires a CSV beside every paper figure, written by
# the same run of the same script, so that the plotted values are re-derivable
# and diffable against the figure it describes. The blanket rule left every
# paper figure's numbers unversioned, which is the failure that convention
# exists to prevent. It stays in force for results/, where one metrics.csv is
# hundreds of megabytes.
!agent_motivation_experiment/paper_figures/*.csv
sglang/

# Experiment run outputs (large: metrics/server_metrics jsonl, agent_logs, plots).
# Cross-run figures live under results/aggregate_analysis/ but the whole tree is
# multi-GB, so it is not version-controlled.
results/
# Cloned dataset repo (separate git repo, 26M)
qwen-bailian-usagetraces-anon/

# SWE replay transcripts over GitHub's 100 MB limit. They live on disk and in
# the NHNHOME backup (md5-verified at the 2026-08-27 recovery); the 51 MB
# short7k file that the workload actually replays IS tracked. Committing the
# two below broke every push until the history was rewritten on 2026-08-28.
agent_motivation_experiment/workloads/codingagent_request_level_poisson/data/transcript_swe_calls.jsonl
agent_motivation_experiment/workloads/codingagent_request_level_poisson/data/transcript_swe_calls_mix1500.jsonl

# macOS AppleDouble sidecars. A backup copy of this tree on an exFAT volume
# grows one ._<name> file per real file, and a single `git add -A` from such
# a copy would commit all of them.
._*
.DS_Store

# kubectl's local cache, created by running kubectl from inside the experiment
# directory. Discovery data and HTTP cache only -- no credentials -- but it is
# machine state, not part of the experiment.
agent_motivation_experiment/.kube/
